# Trade101 — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every key here is read by the BACKEND only — none is exposed to the browser.

# --- Required for the AI narration ---------------------------------------
# A named Claude API key (create it in the Anthropic Console as "Trade101-Analysis").
# This one key runs the whole app; per-feature spend is tracked in-app regardless
# of how many keys you use — see GET /usage.
TRADE101_ANALYSIS_KEY=

# --- Required for news + peers -------------------------------------------
# Free Finnhub key: company news and the peer list.
TRADE101_NEWS_KEY=

# --- Optional: split keys for per-key billing in the Anthropic Console -----
# Each falls back to TRADE101_ANALYSIS_KEY when unset, so leaving these empty is
# a fully supported setup. Set one only when you want that purpose billed to its
# own key in the Console; GET /usage breaks spend down by purpose either way.
TRADE101_RESEARCH_KEY=
TRADE101_ECOSYSTEM_KEY=
TRADE101_ORCHESTRATOR_KEY=

# --- Providers (pluggable; defaults need no key) --------------------------
TRADE101_MODEL=claude-sonnet-5
TRADE101_NEWS_PROVIDER=finnhub
TRADE101_MARKET_DATA_PROVIDER=yahoo
TRADE101_MARKET_DATA_KEY=            # only for a licensed data provider
TRADE101_SEARCH_PROVIDER=none
TRADE101_SEARCH_KEY=                 # only for a future research/search provider
TRADE101_RELATIONSHIP_PROVIDER=none  # supplier/customer/partner links need a licensed dataset
TRADE101_RELATIONSHIP_KEY=           # until one is set, those edges are shown as unsourced
TRADE101_CACHE_URL=                  # optional Redis URL; unset = in-process cache

# --- App config -----------------------------------------------------------
BACKEND_PORT=8000
TRADE101_DB=                         # optional SQLite path; default data/trade101.db

# --- Image generation (logo only, optional, independent of the app) --------
OPENROUTER_API_KEY=
