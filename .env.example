# Trade Craft — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Claude API key ---
# BYOK (bring-your-own-key, added 2026-09-17): on a live/shared deploy, each
# VISITOR pastes their own Anthropic key into the app itself — no env var
# needed for that. TRADE101_ANALYSIS_KEY below is a LOCAL-DEV-ONLY fallback
# (used when no visitor key is supplied) so you don't have to paste a key
# into your own browser every time you test locally. Do NOT set this on a
# shared/deployed host — a visitor without their own key would silently
# fall back to spending yours. See docs/DEPLOY.md.
TRADE101_ANALYSIS_KEY=
TRADE101_MODEL=claude-sonnet-5

# --- News provider ---
# Finnhub free tier (US-listed symbols). Falls back to keyless Google News /
# Yahoo Finance for non-US listings regardless of whether this is set.
TRADE101_NEWS_KEY=
# TRADE101_NEWS_PROVIDER: "finnhub" (default, with the Google/Yahoo fallback
# chain), or force "yahoo"/"google" directly.
TRADE101_NEWS_PROVIDER=finnhub

# TRADE101_SEC_CONTACT: SEC EDGAR requires a descriptive User-Agent with real
# contact info (their fair-access policy) — set this to an email you're okay
# being public in outgoing request headers. Leave blank to use a generic
# placeholder (SEC filings lookups will still work; it's just not a real contact).
TRADE101_SEC_CONTACT=

# --- App config ---
BACKEND_PORT=8000
