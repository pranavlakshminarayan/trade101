# Trade101 — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Claude API keys (one per agent, for per-component usage tracking) ---
# Create separately-named keys in the Anthropic Console:
#   Trade101-Orchestrator, Trade101-Research, Trade101-Analysis, Trade101-Ecosystem
# Needed from Milestone 3 onward (the AI narration). Not required for M0-M2.
TRADE101_ORCHESTRATOR_KEY=
TRADE101_RESEARCH_KEY=
TRADE101_ANALYSIS_KEY=
TRADE101_ECOSYSTEM_KEY=

# --- News / scraping provider (choose one at Milestone 3) ---
# e.g. Firecrawl / Bright Data / Exa, plus a news API if used.
TRADE101_NEWS_KEY=
TRADE101_SCRAPE_KEY=

# TRADE101_SEC_CONTACT: SEC EDGAR requires a descriptive User-Agent with real
# contact info (their fair-access policy) — set this to an email you're okay
# being public in outgoing request headers. Leave blank to use a generic
# placeholder (SEC filings lookups will still work; it's just not a real contact).
TRADE101_SEC_CONTACT=

# --- Image generation (logo only, optional, independent of the app) ---
OPENROUTER_API_KEY=

# --- App config ---
BACKEND_PORT=8000

# --- Pre-share safeguards for /analyze + /ask (only needed once you share the URL) ---
# TRADE101_ACCESS_TOKEN: if set, /analyze and /ask require this exact value as the
# X-Access-Token header. Share the link as https://yourapp/?token=<this value> once —
# the frontend saves it locally and strips it from the visible URL after that.
# Leave blank for local/personal use; the gate is a no-op when this is unset.
TRADE101_ACCESS_TOKEN=
# TRADE101_DAILY_CAP: max combined /analyze + /ask calls per UTC day, across all
# visitors (backstop even if the token above leaks). Default 50 if unset.
TRADE101_DAILY_CAP=50
